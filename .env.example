# ─────────────────────────────────────────────────────────────
#  Plantilla de variables de entorno (Módulo 7.3).
#  NO pongas valores reales aquí. Copia a .env (ignorado por git) y rellena.
# ─────────────────────────────────────────────────────────────

# SQL Server — el pool DEBE estar acotado (Módulo 6: presupuesto de RAM). Usa el DNS
# canónico (dbo.MotorBaseDatos.HostDefault en Aba/database/scripts/002), no una IP fija,
# para que rotar el host/IP del VPS nunca exija tocar este archivo (dinámico).
SA_PASSWORD=
DB_CONNECTION_STRING=Server=db.aba.andrescortes.dev,1433;Database=ABA_Control;User Id=sa;Password=;TrustServerCertificate=True;Max Pool Size=20;Min Pool Size=2;Connect Timeout=15;

# JWT — la clave debe tener al menos 32 caracteres (256 bits)
JWT_KEY=
JWT_ISSUER=abaproblem-api
JWT_AUDIENCE=abaproblem-clients

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Frontend (origen exacto para CORS y redirección post-login)
FRONTEND_BASE_URL=https://aba.andrescortes.dev

# Red Docker desde la que se confía el header X-Forwarded-For. Módulo 5.3 — nunca
# confiar en X-Forwarded-For sin acotar origen. Verifica la subnet REAL en el VPS con
# `docker network inspect bridge | grep Subnet` — no asumas el valor de abajo.
REVERSE_PROXY_TRUSTED_NETWORK=172.17.0.0/16

# MySQL — conexión DIRECTA al motor (nunca a través de ProxySQL, ver PROXYSQL_ADMIN_CONNECTION_STRING
# abajo), dentro de la red Docker (Server=mysql_server, no un hostname público). La cuenta admin debe
# tener SOLO: CREATE, DROP, CREATE USER, GRANT OPTION ON *.* — NUNCA SUPER ni ALL PRIVILEGES ON *.*.
# (No hace falta GRANT SELECT ON information_schema.* — en MySQL 8 ese acceso ya es implícito.)
MYSQL_ADMIN_CONNECTION_STRING=Server=mysql_server;Port=3306;Uid=aba_provisioner;Pwd=;

# ProxySQL (delante de MySQL desde 2026-08-06, ver Aba/INFRAESTRUCTURA.md § 8) — interfaz ADMIN
# (puerto 6032, no el 6033 de datos), cuenta `radmin`. Necesaria para que el backend registre cada
# estudiante nuevo en la tabla mysql_users de ProxySQL (si no, no puede conectar por el puerto público).
PROXYSQL_ADMIN_CONNECTION_STRING=Server=proxysql;Port=6032;Uid=radmin;Pwd=;

# Cloudflare Turnstile (control 1.3 — captcha condicional tras 3 fallos de login).
# SiteKey es pública (la usa el frontend); SecretKey es PRIVADA, solo el backend.
# https://dash.cloudflare.com/ -> Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare API — Módulo DNS Autoservicio (Entregable 3). andrescortes.dev ya está
# gestionado en Cloudflare. El token debe tener scope Zone:DNS:Edit ÚNICAMENTE sobre la
# zona de este dominio (nunca un token de cuenta global) — https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
DNS_DOMINIO_BASE=andrescortes.dev

# Entorno
ASPNETCORE_ENVIRONMENT=Production
